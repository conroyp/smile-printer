# Stripe test-mode secret key. It is only read by the server.
STRIPE_SECRET_KEY=sk_test_...

# Optional: operate on readers belonging to a connected account.
STRIPE_CONNECTED_ACCOUNT_ID=

STRIPE_CURRENCY=eur
# €4.30 keeps 1–4 coffee totals away from Stripe Terminal's test-value codes.
COFFEE_PRICE=430
PORT=3000

# Polling limits for server-driven payments and print jobs.
PAYMENT_POLL_ATTEMPTS=90
PAYMENT_POLL_INTERVAL_MS=1000
PRINT_POLL_ATTEMPTS=15
PRINT_POLL_INTERVAL_MS=1000
